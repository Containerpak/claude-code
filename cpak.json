    },
    {
      "name": "claude-code-linux-arm64-2.1.246.tgz",
      "url": "https://registry.npmjs.org/@anthropic-ai/claude-code-linux-arm64/-/claude-code-linux-arm64-2.1.246.tgz",
      "sha256": "a386085cebf079e71e221f2f44c81bca5597c1b141e7ff0af8c72887aa0a2760",
